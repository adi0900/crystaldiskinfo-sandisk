+BOOL CAtaSmart::AddSanDisk55DD(INT physicalDriveId, INT scsiPort, INT scsiTargetId, INT scsiBus, const CString& pnpDeviceId)
+{
+	const HANDLE handle = GetIoCtrlHandle(physicalDriveId);
+	if (handle == INVALID_HANDLE_VALUE)
+	{
+		return FALSE;
+	}
+
+	SanDisk55DD::Readings readings;
+	GET_LENGTH_INFORMATION length{};
+	DWORD returned = 0;
+	const bool found = SanDisk55DD::Read(handle, readings)
+		&& ::DeviceIoControl(handle, IOCTL_DISK_GET_LENGTH_INFO, nullptr, 0, &length, sizeof(length), &returned, nullptr)
+		&& returned >= sizeof(length) && length.Length.QuadPart > 0;
+	if (!found)
+	{
+		::CloseHandle(handle);
+		return FALSE;
+	}
+
+	ATA_SMART_INFO disk{};
+	disk.SanDiskCapabilities = SanDisk55DD::ReadCapabilities(handle);
+	::CloseHandle(handle);
+	disk.PhysicalDriveId = physicalDriveId;
+	disk.ScsiPort = scsiPort;
+	disk.ScsiTargetId = scsiTargetId;
+	disk.ScsiBus = scsiBus;
+	disk.PnpDeviceId = pnpDeviceId;
+	disk.Model = L"SanDisk Extreme 55DD";
+	disk.SerialNumber = readings.Serial;
+	disk.SerialNumber.Trim();
+	disk.ModelSerial = GetModelSerial(disk.Model, disk.SerialNumber);
+	disk.FirmwareRev = L"0010";
+	disk.Interface = L"SCSI";
+	disk.InterfaceType = INTERFACE_TYPE_USB;
+	disk.CommandType = CMD_TYPE_SANDISK_55DD;
+	disk.CommandTypeString = commandTypeString[CMD_TYPE_SANDISK_55DD];
+	disk.TotalDiskSize = static_cast<DWORD>(length.Length.QuadPart / 1000000);
+	disk.IsSsd = TRUE;
+	disk.NominalMediaRotationRate = 1;
+	disk.HostReads = readings.HostReads;
+	disk.Temperature = readings.Temperature;
+	disk.SanDiskSensors = readings.Sensors;
+	disk.SanDiskInternalFirmware = readings.InternalFirmware;
+	disk.LogicalSectorSize = disk.SanDiskCapabilities.LogicalSector;
+	disk.PhysicalSectorSize = disk.SanDiskCapabilities.PhysicalSector;
+	disk.IsTrimSupported = disk.SanDiskCapabilities.Trim == 1;
+	disk.DiskStatus = DISK_STATUS_UNKNOWN;
+	disk.Life = -1;
+	disk.HostWrites = -1;
+	disk.NandWrites = -1;
+	disk.GBytesErased = -1;
+	disk.WearLevelingCount = -1;
+	disk.DetectedPowerOnHours = -1;
+	disk.MeasuredPowerOnHours = -1;
+	vars.Add(disk);
+	return TRUE;
+}
