+std::vector<CDiskInfoDlg::SanDiskDiagnosticRow> CDiskInfoDlg::GetSanDiskDiagnosticRows(DWORD i)
+{
+	const auto& disk = m_Ata.vars[i];
+	const auto& caps = disk.SanDiskCapabilities;
+	const auto& sensor = disk.SanDiskSensors;
+	const CString unavailable = L"Unavailable";
+	const auto formatNumber = [&unavailable](DWORD number, LPCWSTR unit) {
+		if (number == 0)
+		{
+			return unavailable;
+		}
+		CString result;
+		result.Format(L"%lu %s", number, unit);
+		return result;
+	};
+	const auto formatTemperature = [this, &unavailable](int degrees) {
+		if (degrees == SanDisk55DD::UnknownTemperature)
+		{
+			return unavailable;
+		}
+		CString result;
+		if (m_bFahrenheit)
+		{
+			result.Format(L"%d \u00B0F", degrees * 9 / 5 + 32);
+		}
+		else
+		{
+			result.Format(L"%d \u00B0C", degrees);
+		}
+		return result;
+	};
+	const auto enabled = [&unavailable](int state) {
+		return state < 0 ? unavailable : CString(state ? L"Enabled" : L"Disabled");
+	};
+
+	CString hostReads = unavailable;
+	if (disk.HostReads >= 0)
+	{
+		hostReads.Format(L"%d GiB", disk.HostReads);
+	}
+	using namespace SanDisk55DD;
+	return {
+		{L"Lifetime host reads", hostReads, L"SanDisk log 0x30"},
+		{L"Controller temperature", formatTemperature(disk.Temperature), L"SanDisk log 0x32"},
+		{L"NAND channels 1 to 4", formatTemperature(sensor[Nand1]) + L" / " + formatTemperature(sensor[Nand2])
+			+ L" / " + formatTemperature(sensor[Nand3]) + L" / " + formatTemperature(sensor[Nand4]), L"SanDisk log 0x32"},
+		{L"Recorded minimum / maximum", formatTemperature(sensor[Minimum]) + L" / " + formatTemperature(sensor[Maximum]), L"SanDisk log 0x32"},
+		{L"Board sensors A / B", formatTemperature(sensor[BoardA]) + L" / " + formatTemperature(sensor[BoardB]), L"SanDisk log 0x32"},
+		{L"Internal firmware ID", disk.SanDiskInternalFirmware.IsEmpty() ? unavailable : disk.SanDiskInternalFirmware, L"SanDisk log 0x31"},
+		{L"Logical / physical sector size", formatNumber(caps.LogicalSector, L"B") + L" / " + formatNumber(caps.PhysicalSector, L"B"), L"Windows storage"},
+		{L"TRIM", enabled(caps.Trim), L"Windows storage"},
+		{L"Read cache / write-back cache", enabled(caps.ReadCache) + L" / " + enabled(caps.WriteCache), L"SCSI mode page 0x08"},
+		{L"Power-on hours / cycles", L"Unavailable over USB", L"Standard SMART"},
+		{L"Lifetime host / NAND writes", L"Unavailable over USB", L"Standard SMART"},
+		{L"Wear / spare capacity", L"Unavailable over USB", L"Standard SMART"},
+		{L"Media errors / self-test history", L"Unavailable over USB", L"Standard SMART"},
+		{L"Unsafe shutdowns", L"Unavailable over USB", L"Standard SMART"},
+	};
+}
